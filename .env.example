# ====================================================================
# NEXUS PORTFOLIO PLATFORM — ENVIRONMENT CONFIGURATION
# Replace the placeholder values with your real Supabase credentials.
# NEVER commit your actual .env file or service-role keys.
# ====================================================================

# 1. Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Supabase Anonymous Public API Key (safe for browser client)
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# NOTE: When running locally without Supabase credentials configured,
# Nexus automatically activates its high-fidelity Mock / Local Engine
# allowing complete testing of the 3D Universe and Admin Dashboard!
